<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/budget_bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/budget_bg_handle_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/cairo_font_family"
            android:text="@string/budget_edit_limit_title"
            android:textColor="@color/budget_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseLimit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/budget_cancel"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/budget_text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLimitSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/cairo_font_family"
        android:textColor="@color/budget_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etBudgetLimitAmount"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/budget_bg_input_field"
        android:fontFamily="@font/cairo_font_family"
        android:hint="@string/budget_edit_limit_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:paddingHorizontal="14dp"
        android:textColor="@color/budget_text_primary"
        android:textColorHint="@color/budget_text_secondary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearBudgetLimit"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:fontFamily="@font/cairo_font_family"
            android:text="@string/budget_clear_limit"
            android:textAllCaps="false"
            android:textColor="@color/budget_expense"
            android:textSize="13sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/budget_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBudgetLimit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:fontFamily="@font/cairo_font_family"
            android:text="@string/budget_save_limit"
            android:textAllCaps="false"
            android:textColor="@color/budget_text_on_card"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/budget_primary"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
