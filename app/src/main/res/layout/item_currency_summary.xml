<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvCurrencyName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="ريال"
        android:textStyle="bold"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvTotalDebit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="0"
        android:textStyle="bold"
        android:textSize="13sp"
        android:textColor="@color/colorDebit"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvTotalCredit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="0"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/colorCredit"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvNetBalance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="0"
        android:textStyle="bold"
        android:textSize="13sp"
        android:gravity="center" />
    <ImageView
        android:id="@+id/arrowEditView"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:padding="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_show_details"
        android:contentDescription="@string/edit"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
