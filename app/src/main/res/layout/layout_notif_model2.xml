<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <!-- الصورة الجانبية -->
        <ImageView
            android:id="@+id/ivNotifImage"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNotifTitle"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="4dp" />

            <!-- التفاصيل -->
            <TextView
                android:id="@+id/tvNotifBody"
                style="@style/TextAppearance.Compat.Notification.Line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="5"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- حاوية الأزرار -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnMainAction"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:text="@string/subscribe_now"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingHorizontal="8dp"
            android:background="@drawable/bg_notif_btn_amber"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnRemindLater"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="16dp"
            android:text="@string/remind_later"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:background="@drawable/bg_notif_btn_secondary" />
    </LinearLayout>
</LinearLayout>
