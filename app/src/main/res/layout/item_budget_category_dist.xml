<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <View
        android:id="@+id/viewCategoryColorDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/budget_bg_dot_square" />

    <TextView
        android:id="@+id/tvCategoryDistName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_font_family"
        android:maxLines="1"
        android:textColor="@color/budget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCategoryDistPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:fontFamily="@font/cairo_font_family"
        android:minWidth="46dp"
        android:textAlignment="center"
        android:textColor="@color/budget_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvCategoryDistAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo_font_family"
        android:textColor="@color/budget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
