<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/budget_bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/budget_bg_handle_bar" />

        <!-- الترويسة: العنوان الملون + زر الإغلاق -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/budget_expense"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseSheet"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/budget_cancel"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/budget_text_secondary" />
        </LinearLayout>

        <!-- حقل المبلغ -->
        <TextView
            android:id="@+id/tvAmountLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/budget_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBudgetAmount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/budget_bg_input_field"
            android:hint="@string/budget_amount_hint"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:paddingHorizontal="14dp"
            android:textColor="@color/budget_text_primary"
            android:textColorHint="@color/budget_text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- شبكة التصنيفات (3 أعمدة) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/budget_category_label"
            android:textColor="@color/budget_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBudgetCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- الملاحظة / البيان -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/budget_note_label"
            android:textColor="@color/budget_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBudgetNote"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/budget_bg_input_field"
            android:hint="@string/budget_note_expense_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/budget_text_primary"
            android:textColorHint="@color/budget_text_secondary"
            android:textSize="14sp" />

        <!-- التاريخ القابل للتعديل -->
        <LinearLayout
            android:id="@+id/layoutEntryDate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/budget_bg_input_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_modern_calendar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/budget_date_label"
                android:textColor="@color/budget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEntryDateValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/budget_text_primary"
                android:textDirection="ltr"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- زر الحفظ الرئيسي -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveBudgetEntry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="@string/budget_save_and_update"
            android:textAllCaps="false"
            android:textColor="@color/budget_text_on_card"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/budget_expense"
            app:cornerRadius="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
