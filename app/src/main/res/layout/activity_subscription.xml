<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main_root"
    android:background="@color/background_color"> <!-- خلفية فاتحة أنيقة -->
    <!--    android:layoutDirection="rtl"-->
    <!-- شريط الأدوات العلوي (كما في ملفك مع تعديلات بسيطة) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floating_toolbar_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:id="@+id/status_bar_spacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@android:color/transparent" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_modern_back"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subscribing_titel"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_centerInParent="true"/>
            </RelativeLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:id="@+id/layoutMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/floating_toolbar_card"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- قسم الهيرو (العنوان الجذاب) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E3A8A"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/elevate_wallet"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/budget_control_life_discount"
                    android:textColor="#DBEAFE"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvChoosePlan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/planning_type"
                android:textSize="18sp"
                android:textStyle="bold"
                android:clickable="true"
                android:visibility="gone"
                android:focusable="true"
                android:textColor="@color/black"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"/>
            <!-- تابات التجديد (تلقائي / يدوي) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_switch_container"
                android:padding="4dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tabAutoRenew"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/auto_renew"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_tab_selected"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tabPrepaid"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/manual_renew"
                    android:textColor="#757575"
                    android:background="@android:color/transparent"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tvPlanDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/switchTab_03"
                android:gravity="center"
                android:textSize="12sp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/black"
                android:layout_marginTop="4dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. الباقة الشهرية -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMonthly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="#E2E8F0"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="4dp">

                            <RadioButton
                                android:id="@+id/radioMonthly"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:checked="false"
                                android:buttonTint="@color/primary_blue"/>
                            <TextView
                                android:id="@+id/tvMonthlyTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/monthly_subscribe"
                                android:textColor="@color/primaryColor"
                                android:textStyle="bold"
                                android:layout_toEndOf="@id/radioMonthly"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:textSize="18sp"/>

                        </RelativeLayout>
                        <TextView
                            android:id="@+id/tvPriceMonthly"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3$"
                            android:textColor="@color/primary_blue"
                            android:textStyle="bold"
                            android:textSize="24sp"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/all_basic_features"
                            android:textColor="@color/black"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. الباقة السنوية (النخبة) + الشارة (Badge) -->
                <!-- نستخدم FrameLayout للسماح للشارة بالخروج عن إطار البطاقة -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardYearly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="#3B82F6"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp">

                                <RadioButton
                                    android:id="@+id/radioYearly"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:checked="false"
                                    android:buttonTint="@color/primary_blue"/>
                                <TextView
                                    android:id="@+id/tvYearlyTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_toEndOf="@id/radioYearly"
                                    android:layout_centerVertical="true"
                                    android:layout_marginStart="2dp"
                                    android:orientation="vertical"
                                    android:text="@string/annual_subscription_recommended"
                                    android:textColor="@color/primaryColor"
                                    android:textStyle="bold"
                                    android:textSize="18sp"/>
                            </RelativeLayout>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvPriceYearly"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="30$"
                                    android:textColor="@color/primary_blue"
                                    android:textStyle="bold"
                                    android:textSize="28sp"
                                    android:layout_marginTop="4dp"
                                    tools:ignore="MissingClass" />
                                <TextView
                                    android:id="@+id/tvYearlySaveBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="27$"
                                    android:textColor="@color/login_color"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="4dp"
                                    android:visibility="visible"
                                    tools:visibility="visible"/>
                            </LinearLayout>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/save_20_vs_monthly"
                                android:textColor="#D97706"
                                android:background="#FEF3C7"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:layout_marginTop="8dp"
                                android:textStyle="bold"
                                android:textSize="12sp"/>

                            <!-- مميزات المرحلة الأولى -->
                            <LinearLayout
                                android:id="@+id/layoutPhase1Features"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/additional_15_september"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"
                                    android:visibility="gone"
                                    android:layout_marginBottom="4dp"/>
                                <TextView
                                    android:id="@+id/tvYearlySaveSubtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/future_up_to_30"
                                    android:textColor="@color/black"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- الشارة (Badge) - يتم التحكم بظهورها من الجافاسكريبت/جافا -->
                    <TextView
                        android:id="@+id/badgePhase1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/future_discounts"
                        android:textColor="#78350F"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:backgroundTint="#F59E0B"
                        android:background="@drawable/badge_background"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:layout_gravity="top|center_horizontal"
                        android:elevation="6dp"
                        android:visibility="visible"/>
                    <!-- ملاحظة: يتطلب إنشاء ملف shape صغير لـ badge_background.xml لتدوير الحواف، أو استخدام CardView -->
                </FrameLayout>

                <!-- 3. باقة مدى الحياة -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLifetime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="2dp"
                    app:cardBackgroundColor="#212121"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <RadioButton
                                android:id="@+id/radioLifetime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:checked="false"
                                android:buttonTint="@color/primary_blue" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/radioLifetime"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="12dp"
                                android:text="@string/lifetime_subscribe1"
                                android:textColor="#FFFFFF"
                                android:textStyle="bold"
                                android:textSize="18sp"/>
                            ️
                            <!-- شارة فترة محدودة -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="@string/limit_time"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="#0F172A"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"/>
                        </RelativeLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/tvOldPriceLifetime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100$"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#BDBDBD"
                                android:visibility="gone"
                                tools:visibility="visible"/>
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp">
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">
                                    <TextView
                                        android:id="@+id/tvPriceLifetimeDiscounted"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="95$"
                                        android:textColor="#FFC107"
                                        android:textStyle="bold"
                                        android:textSize="24sp"/>
                                    <!--                                <View-->
                                    <!--                                    android:layout_width="0dp"-->
                                    <!--                                    android:layout_height="0dp"-->
                                    <!--                                    android:layout_weight="1"/>-->
                                    <TextView
                                        android:id="@+id/tvDiscountLabel"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="--"
                                        android:textColor="#FFC107"
                                        android:layout_marginEnd="8dp"
                                        android:gravity="end"
                                        android:textSize="24sp"
                                        android:textStyle="bold"
                                        android:layout_alignParentEnd="true"
                                        tools:ignore="HardcodedText" />
                                </RelativeLayout>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lifetime_sub_titel"
                            android:textColor="#90CAF9"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/tvPromoTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" "
                            android:visibility="gone"
                            android:textColor="#FFC107"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- نص الانتهاء (كما في ملفك) -->
                <TextView
                    android:id="@+id/tvSubscriptionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="#DC2626"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="Expiry Date: 01-01-2026"
                    android:visibility="gone"
                    tools:visibility="visible"/>

                <!-- زر تأكيد الشراء -->
                <Button
                    android:id="@+id/btnConfirmPurchase"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/subscribe_now"
                    android:textSize="18sp"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:backgroundTint="#3B82F6"
                    app:cornerRadius="12dp"
                    android:enabled="true"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/secure_google_payment"
                    android:gravity="center"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- شاشة التحميل (كما في ملفك المرفق) -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>
    </FrameLayout>

</RelativeLayout>