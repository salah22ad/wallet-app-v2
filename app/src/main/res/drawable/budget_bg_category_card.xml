<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/budget_surface_subtle"/>
            <stroke android:width="2dp" android:color="@color/budget_primary"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/budget_card_bg"/>
            <stroke android:width="1dp" android:color="@color/budget_border"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
