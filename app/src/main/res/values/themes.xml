<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light) -->
    <style name="Base.Theme.Daftree" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color & Material 3 Harmonized Tokens -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Enable edge to edge -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="colorPrimaryDark">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="actionBarInsetTop">@dimen/status_bar_height</item>
        <item name="toolbarStyle">@style/Widget.MyApp.Toolbar</item>
    </style>

    <style name="Theme.Daftree" parent="Base.Theme.Daftree">
        <!-- Customize your light theme here -->
    </style>

    <style name="Widget.MyApp.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/black</item>
        <item name="subtitleTextColor">@color/black</item>
        <item name="navigationIconTint">@color/black</item>
        <item name="android:background">@color/white</item>
    </style>

    <style name="ShapeAppearance.Material3.Corner.Top.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
    </style>

    <style name="Widget.MaterialComponents.Button.OutlinedButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:paddingLeft">@dimen/btn_padding_left</item>
        <item name="android:paddingRight">@dimen/btn_padding_right</item>
        <item name="strokeColor">@color/btn_stroke_color_selector</item>
        <item name="strokeWidth">@dimen/btn_stroke_size</item>
    </style>

    <style name="App.SearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/grey_500</item>
        <item name="android:searchIcon">@drawable/ic_search_white</item>
        <item name="android:closeIcon">@drawable/ic_close_white</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <style name="App.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="contentInsetStart">0dp</item>
        <item name="contentInsetEnd">0dp</item>
    </style>

    <style name="Toolbar.TitleText" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
        <item name="android:textSize">22dp</item>
    </style>

    <style name="TextAppearance.App.Cairo.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
    </style>

    <style name="TextAppearance.App.Cairo.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
    </style>

    <style name="TextAppearance.App.Cairo.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
    </style>

    <style name="Widget.App.Button.Cairo" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.App.EditText.Cairo" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="HelpSectionTitle" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox.Dense">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="HelpSectionContent" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox.Dense">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <style name="HelpContactItem" parent="Widget.Material3.AutoCompleteTextView.OutlinedBox.Dense">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>

    <style name="UnclosableDialogTheme" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Theme.Daftree.FullScreenDialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <style name="FullScreenDialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowSoftInputMode">stateAlwaysHidden</item>
    </style>

    <style name="ShapeAppearance.Material3.SmallComponent" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.Material3.MediumComponent" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.Material3.LargeComponent" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Theme.Manus" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#000000</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.App.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="LanguageRadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>

    <style name="BottomSlideDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

    <style name="CustomAlertDialogStyle" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.8</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="SplashAlertDialogStyle" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowMinWidthMajor">95%</item>
        <item name="android:windowMinWidthMinor">95%</item>
    </style>

    <style name="FullScreenTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="BottomSlideDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.App.TopRounded" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Splash Theme متوافق مع Edge-to-Edge -->
    <style name="SplashTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window_background</item>
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorPrimaryDark">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet.Modal</item>
    </style>

    <style name="Widget.App.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- ثيم خط Cairo الشامل للأنشطة وديالوجات Material 3 (للغات المدعومة فقط) -->
    <style name="TextAppearance.Daftree.Cairo.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
    </style>

    <style name="TextAppearance.Daftree.Cairo.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
    </style>

    <style name="TextAppearance.Daftree.Cairo.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
    </style>

    <style name="TextAppearance.Daftree.Cairo.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
    </style>

    <style name="TextAppearance.Daftree.Cairo.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
    </style>

    <style name="Widget.Daftree.Dialog.Title.Cairo" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
    </style>

    <style name="Widget.Daftree.Dialog.Body.Cairo" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
    </style>

    <style name="Widget.Daftree.Dialog.Button.Cairo" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
    </style>

    <style name="ThemeOverlay.Daftree.MaterialAlertDialog.Cairo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Widget.Daftree.Dialog.Title.Cairo</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Widget.Daftree.Dialog.Body.Cairo</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Daftree.Dialog.Button.Cairo</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Daftree.Dialog.Button.Cairo</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Daftree.Dialog.Button.Cairo</item>
    </style>

    <style name="ThemeOverlay.Daftree.Font.Cairo" parent="">
        <item name="android:fontFamily">@font/cairo_font_family</item>
        <item name="fontFamily">@font/cairo_font_family</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Daftree.Cairo.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.Cairo.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Daftree.Cairo.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.Cairo.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Daftree.Cairo.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Daftree.Cairo.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Daftree.Cairo.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.Cairo.LabelMedium</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Daftree.MaterialAlertDialog.Cairo</item>
    </style>
</resources>
