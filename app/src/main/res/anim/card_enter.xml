<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">

    <!-- شفافية من 0 إلى 1 -->
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1"
        android:duration="450" />

    <!--زحف خفيف لأعلى-->
    <translate
        android:fromYDelta="60dp"
        android:toYDelta="0"
        android:duration="450"/>
</set>
